# Add ONLY these blocks inside the existing
# leadpilotai.spiralloopstechnologies.com server { ... }
# Do NOT modify /abdu/ or /genai/ locations.

    location = /videoportal {
        return 301 /videoportal/;
    }

    location ^~ /videoportal/ {
        proxy_pass http://127.0.0.1:5055;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Prefix /videoportal;
        proxy_read_timeout 300s;
        client_max_body_size 600m;
    }
