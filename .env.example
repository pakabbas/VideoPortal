FLASK_SECRET_KEY=change-me-to-a-long-random-string
APPLICATION_ROOT=/videoportal

# MySQL / MariaDB
DATABASE_URL=mysql+pymysql://videoportal:CHANGE_ME@127.0.0.1:3306/videoportal

# Seed admin (used by init_db / first boot)
ADMIN_EMAIL=admin@videoportal.local
ADMIN_PASSWORD=ChangeMeAdmin123!
ADMIN_NAME=Portal Admin

# Uploads (absolute path on server recommended)
UPLOAD_FOLDER=uploads

# DocuSign Developer sandbox (account-d.docusign.com)
# Create a free developer account: https://developers.docusign.com/
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_RSA_KEY_PATH=secrets/docusign_private.key
DOCUSIGN_AUTH_SERVER=account-d.docusign.com
DOCUSIGN_BASE_PATH=https://demo.docusign.net/restapi
DOCUSIGN_AGREEMENT_PDF=static/docs/manager_agreement.pdf
